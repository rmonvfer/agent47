  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.jakewharton.mosaic</groupId>
  <artifactId>mosaic-runtime-jvm</artifactId>
  <version>0.18.0</version>
  <name>Mosaic runtime</name>
  <description>Jetpack Compose for console UI</description>
  <url>https://github.com/JakeWharton/mosaic/</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>jakewharton</id>
      <name>Jake Wharton</name>
      <url>https://github.com/JakeWharton/</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/JakeWharton/mosaic.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/JakeWharton/mosaic.git</developerConnection>
    <url>https://github.com/JakeWharton/mosaic/</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.compose.runtime</groupId>
      <artifactId>runtime-desktop</artifactId>
      <version>1.8.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.androidx.lifecycle</groupId>
      <artifactId>lifecycle-runtime-compose-desktop</artifactId>
      <version>2.9.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core-jvm</artifactId>
      <version>1.10.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.jakewharton.mosaic</groupId>
      <artifactId>mosaic-terminal-jvm</artifactId>
      <version>0.18.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.10</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.jakewharton.mosaic</groupId>
      <artifactId>mosaic-tty-terminal-jvm</artifactId>
      <version>0.18.0</version>
      <scope>runtime</scope>
